{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "dev-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--mode",
        "http",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "dist-http",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "dist"
      ],
      "port": 4180
    },
    {
      "name": "dev-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SUPABASE_URL=",
        "VITE_SUPABASE_ANON_KEY=",
        "npm",
        "run",
        "dev",
        "--",
        "--mode",
        "http",
        "--port",
        "5175"
      ],
      "port": 5175
    },
    {
      "name": "tablet-worktree",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SUPABASE_URL=",
        "VITE_SUPABASE_ANON_KEY=",
        "npm",
        "--prefix",
        "../subwayseal-tablet",
        "run",
        "dev",
        "--",
        "--mode",
        "http",
        "--port",
        "5176"
      ],
      "port": 5176
    }
  ]
}